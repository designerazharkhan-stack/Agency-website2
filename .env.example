# ==========================================
# Agency Website - Environment Configuration
# ==========================================

# Application URL
APP_URL="https://example.com"

# Gemini AI API Key (Optional server-side integrations)
GEMINI_API_KEY=""

# ==========================================
# Firebase Configuration
# Replace these with your real Firebase Project credentials from Firebase Console:
# Project Settings -> General -> Your apps -> Web app -> SDK setup and configuration
# Note: If left blank or unset, the application automatically runs in seamless local mode
# with built-in persistent storage and high-quality default seed data.
# ==========================================
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="your-app.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-app.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"
